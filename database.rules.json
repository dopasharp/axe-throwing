{
  "rules": {
    ".read": false,
    ".write": false,
    "axeRooms": {
      "$room": {
        ".read": "$room.matches(/^[A-Z0-9]{4,8}$/)",
        ".write": "$room.matches(/^[A-Z0-9]{4,8}$/)",
        "meta": {
          ".validate": "newData.hasChildren(['createdAt'])"
        },
        "axe": {
          ".validate": "newData.hasChildren(['emoji'])"
        },
        "throws": {
          "$t": {
            ".validate": "newData.child('power').isNumber() && newData.child('aimX').isNumber() && newData.child('emoji').isString() && newData.child('emoji').val().length <= 8"
          }
        },
        "state": {
          ".validate": "newData.hasChildren(['thrown','total'])"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
